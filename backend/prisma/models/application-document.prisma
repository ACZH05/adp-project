model ApplicationDocument {
  id                   String               @id @default(uuid()) @db.Uuid
  applicationVersionId String               @map("application_version_id") @db.Uuid
  documentType         DocumentType         @map("document_type")
  fileName             String               @map("file_name")
  fileType             String               @map("file_type")
  fileSize             Int                  @map("file_size")
  storagePath          String               @map("storage_path")
  externalSourceUrl    String?              @map("external_source_url")
  checksum             String?
  uploadStatus         DocumentUploadStatus @default(uploaded) @map("upload_status")
  uploadedAt           DateTime             @default(now()) @map("uploaded_at")
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")
  applicationVersion   ApplicationVersion   @relation(fields: [applicationVersionId], references: [id])
  verificationIssues   VerificationIssue[]

  @@index([applicationVersionId])
  @@index([documentType])
  @@map("application_documents")
}
