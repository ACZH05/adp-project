model Appointment {
  id               String            @id @default(uuid()) @db.Uuid
  applicationId    String            @map("application_id") @db.Uuid
  applicantUserId  String            @map("applicant_user_id") @db.Uuid
  decidedByUserId  String?           @map("decided_by_user_id") @db.Uuid
  requestedAt      DateTime          @default(now()) @map("requested_at")
  preferredStartAt DateTime          @map("preferred_start_at")
  preferredEndAt   DateTime          @map("preferred_end_at")
  scheduledStartAt DateTime?         @map("scheduled_start_at")
  scheduledEndAt   DateTime?         @map("scheduled_end_at")
  status           AppointmentStatus @default(pending)
  applicantNote    String?           @map("applicant_note")
  decisionReason   String?           @map("decision_reason")
  decidedAt        DateTime?         @map("decided_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  application      Application       @relation(fields: [applicationId], references: [id])
  applicant        User              @relation("ApplicantAppointments", fields: [applicantUserId], references: [id])
  decidedBy        User?             @relation("AppointmentDecider", fields: [decidedByUserId], references: [id])
  auditLogs        AuditLog[]
  kpiEvents        KpiEvent[]

  @@index([applicationId])
  @@index([applicantUserId])
  @@index([status])
  @@map("appointments")
}
