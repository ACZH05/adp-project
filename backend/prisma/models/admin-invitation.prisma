model AdminInvitation {
  id               String                @id @default(uuid()) @db.Uuid
  email            String
  role             AdminInvitationRole
  invitedByUserId  String                @map("invited_by_user_id") @db.Uuid
  acceptedByUserId String?               @map("accepted_by_user_id") @db.Uuid
  tokenHash        String                @unique @map("token_hash")
  status           AdminInvitationStatus @default(pending)
  expiresAt        DateTime              @map("expires_at")
  acceptedAt       DateTime?             @map("accepted_at")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")
  invitedByUser    User                  @relation("AdminInvitationSender", fields: [invitedByUserId], references: [id])
  acceptedByUser   User?                 @relation("AdminInvitationAccepter", fields: [acceptedByUserId], references: [id])

  @@index([invitedByUserId])
  @@index([acceptedByUserId])
  @@index([status])
  @@index([expiresAt])
  @@map("admin_invitations")
}
