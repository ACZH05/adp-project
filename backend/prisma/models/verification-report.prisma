model VerificationReport {
  id                     String                    @id @default(uuid()) @db.Uuid
  verificationJobId      String                    @unique @map("verification_job_id") @db.Uuid
  confidenceScore        Float?                    @map("confidence_score")
  overallResult          VerificationOverallResult @map("overall_result")
  manualFallbackRequired Boolean                   @default(false) @map("manual_fallback_required")
  summary                String?
  modelVersion           String?                   @map("model_version")
  promptPolicyVersion    String?                   @map("prompt_policy_version")
  rawResult              Json                      @map("raw_result")
  generatedAt            DateTime                  @default(now()) @map("generated_at")
  createdAt              DateTime                  @default(now()) @map("created_at")
  verificationJob        VerificationJob           @relation(fields: [verificationJobId], references: [id])
  verificationIssues     VerificationIssue[]

  @@map("verification_reports")
}
