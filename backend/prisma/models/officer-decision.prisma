model OfficerDecision {
  id                   String              @id @default(uuid()) @db.Uuid
  applicationId        String              @unique @map("application_id") @db.Uuid
  applicationVersionId String              @map("application_version_id") @db.Uuid
  officerUserId        String              @map("officer_user_id") @db.Uuid
  decisionType         OfficerDecisionType @map("decision_type")
  reasonCode           String?             @map("reason_code")
  reason               String?
  officerNote          String?             @map("officer_note")
  decidedAt            DateTime            @default(now()) @map("decided_at")
  createdAt            DateTime            @default(now()) @map("created_at")
  application          Application         @relation(fields: [applicationId], references: [id])
  applicationVersion   ApplicationVersion  @relation(fields: [applicationVersionId], references: [id])
  officerUser          User                @relation("OfficerUserDecisions", fields: [officerUserId], references: [id])

  @@index([applicationId])
  @@index([applicationVersionId])
  @@index([officerUserId])
  @@map("officer_decisions")
}
